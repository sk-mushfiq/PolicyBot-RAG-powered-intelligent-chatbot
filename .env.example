# ─────────────────────────────────────────
# HR PolicyBot — Environment Configuration
# ─────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# App Settings
APP_NAME=HR PolicyBot
APP_VERSION=1.0.0
DEBUG=False

# Model Settings
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_PROVIDER=openai        # "openai" or "huggingface"
HUGGINGFACE_MODEL=all-MiniLM-L6-v2

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
MAX_TOKENS=1000

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=hr_policies

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
